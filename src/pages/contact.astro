---
import MainLayout from "../layouts/main-layout.astro";
import ContactInfo from "../components/contact-box.tsx";
import ContactForm from "../components/contact-form.tsx";
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<MainLayout title="Sala Okolicznościowa w Zwierzyńcu">
  
  <!-- Banner -->
  <section class="w-full bg-contact bg-cover bg-center aspect-[16/7] sm:aspect-[16/5] lg:aspect-[16/2.8] max-h-[320px] flex justify-center items-end">
    <div
      class="py-2 lg:py-2.5 px-6 lg:px-12 flex flex-col justify-center items-center bg-[#F4EFE6] rounded-tl-[24px] rounded-tr-[24px] gap-1 translate-y-[1px]"
    >
      <h1
        class="text-[22px] leading-[28px] lg:text-[32px] lg:leading-[40px] font-dm capitalize text-primary-200"
      >
        Kontakt
      </h1>
    </div>
  </section>

  <!-- Intro Section -->
  <section
    class="lg:max-w-[1200px] flex flex-col gap-8 lg:gap-10 px-12 xl:px-0 w-full mx-auto pt-[40px] lg:pt-[70px]"
  >
    <h2
      class="text-[26px] text-center capitalize font-dm tracking-wide lg:max-w-[60%] leading-8 md:leading-[52px] md:text-[42px] mx-auto text-text-blue"
    >
      Chętnie oprowadzimy Cię po naszej sali. Zapraszamy na spotkanie.
    </h2>

    <!-- Main Section -->
    <div
      class="grid grid-cols-1 gap-[55px] pt-10 lg:pt-14 lg:grid-cols-3 place-content-center"
    >
      <ContactInfo />
      <ContactForm client:load apiKey={web3FormsKey} />
    </div>
  </section>
</MainLayout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>